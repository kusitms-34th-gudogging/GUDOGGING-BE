# 앱이 읽는 환경변수 목록. 서버에서는 이 파일을 .env 로 복사해 값을 채운다. 절대 커밋하지 말 것.
# 주의: 값 뒤에 인라인 주석을 붙이지 말 것 (docker --env-file 은 주석까지 값으로 읽음)

# --- 공통 (application.yaml) ---
# 서버에서는 호스트를 컨테이너명(mysql) 또는 DB 서버 IP로 바꿀 것
DB_URL=jdbc:mysql://localhost:3306/gudogging?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
DB_USER=
DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
# iOS,Android 클라이언트 ID (콤마 구분)
GOOGLE_CLIENT_IDS=
# Base64, 디코딩 후 32바이트 이상. openssl rand -base64 48 (개발/운영 서로 다른 값)
JWT_SECRET=

# --- 운영 프로필 (application-prod.yaml) ---
SPRING_PROFILES_ACTIVE=prod
# 예: https://api.도메인
SERVER_URI=
# 운영 Redis에 requirepass 설정 시
REDIS_PASSWORD=
# 운영 DB 최초 기동 1회만 update, 이후 validate
JPA_DDL_AUTO=validate
SWAGGER_ENABLED=false
