# 앱이 읽는 환경변수 목록. 로컬은 이 파일을 .env 로 복사해 값을 채운다. 실제 값이 든 .env 는 절대 커밋하지 말 것.
# 개발/운영 앱 서버 .env 는 GitHub Secret(DEV_ENV_FILE / PROD_ENV_FILE)에 .env 전체 내용으로 관리 → 배포 시 자동 반영.
# 새 변수를 추가하면 로컬 .env, 이 파일, 두 Secret 을 모두 갱신할 것 (누락 시 배포 전 검사에서 실패).
# 주의: 값 뒤에 인라인 주석을 붙이지 말 것 (docker --env-file 은 주석까지 값으로 읽음)

# --- 공통 (application.yaml) ---
# 서버에서는 호스트를 컨테이너명(mysql) 또는 DB 서버 IP로 바꿀 것
DB_URL=jdbc:mysql://localhost:3306/gudogging?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
DB_USER=
DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
# iOS,Android 클라이언트 ID (콤마 구분)
GOOGLE_CLIENT_IDS=
# Base64, 디코딩 후 32바이트 이상. openssl rand -base64 48 (개발/운영 서로 다른 값)
JWT_SECRET=

# Apple 로그인 (Apple Developer > Services ID / Team ID / Sign in with Apple Key)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 파일 내용 (PKCS#8 PEM). 줄바꿈은 \n 문자열로 넣어도 됨
APPLE_PRIVATE_KEY=
# DB 컬럼 암호화 키. Base64, 디코딩 후 정확히 32바이트. openssl rand -base64 32 (변경 시 기존 암호문 복호화 불가)
ENCRYPTION_KEY=

# Swagger 에 표시할 서버 주소 (개발 서버: http://서버IP:8080, 운영: https://api.도메인)
SERVER_URI=http://localhost:8080

# --- 개발 서버 docker-compose.dev.yml 전용 (MySQL 컨테이너 초기화) ---
# 서버에서는 DB_URL 호스트를 mysql, REDIS_HOST 를 redis(compose 서비스명)로 설정
# DB_USER / DB_PASSWORD 는 MYSQL_USER / MYSQL_PASSWORD 와 같은 값
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=gudogging
MYSQL_USER=gudogging
MYSQL_PASSWORD=
TZ=Asia/Seoul

# --- 운영 프로필 (application-prod.yaml) ---
SPRING_PROFILES_ACTIVE=prod
# 운영 Redis에 requirepass 설정 시
REDIS_PASSWORD=
# 운영 DB 최초 기동 1회만 update, 이후 validate
JPA_DDL_AUTO=validate
SWAGGER_ENABLED=false
